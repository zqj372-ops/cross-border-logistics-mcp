{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-11/envelope.schema.json",
  "title": "Cross-border Logistics MCP response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "data", "source_refs", "assumptions", "warnings", "blockers", "calculation_trace", "review_status", "audit_id"],
  "properties": {
    "schema_version": { "const": "2026-08-11.v1" },
    "request_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "status": { "type": "string", "enum": ["success", "needs_input", "manual_review", "blocked", "unavailable"] },
    "data": {
      "description": "Tool-specific object validated by the tool contract, or null when no result is safe to expose.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "cargo-result.schema.json" },
        { "$ref": "container-plan.schema.json" },
        { "$ref": "quote-result.schema.json" },
        { "$ref": "customs-search-result.schema.json" },
        { "$ref": "customs-assessment.schema.json" },
        { "$ref": "data-status.schema.json" },
        { "$ref": "knowledge-search-result.schema.json" },
        { "$ref": "write-result.schema.json" }
      ]
    },
    "source_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/SourceRef" }, "uniqueItems": true },
    "assumptions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Notice" } },
    "warnings": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Notice" } },
    "blockers": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Notice" } },
    "calculation_trace": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/CalculationStep" } },
    "review_status": { "type": "string", "enum": ["not_required", "pending", "approved", "rejected", "manual_review"] },
    "audit_id": { "$ref": "common.schema.json#/$defs/Identifier" }
  }
}
