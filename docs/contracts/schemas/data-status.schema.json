{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-11/data-status.schema.json",
  "title": "System data status",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "system", "ready", "test_data", "evaluated_at", "last_source_check_at", "reasons", "release_ids"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/Version" },
    "system": { "type": "string", "minLength": 1, "maxLength": 120 },
    "ready": { "type": "boolean" },
    "test_data": { "type": "boolean" },
    "evaluated_at": { "$ref": "common.schema.json#/$defs/DateTime" },
    "last_source_check_at": { "oneOf": [{ "$ref": "common.schema.json#/$defs/DateTime" }, { "type": "null" }] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "release_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Identifier" }, "uniqueItems": true }
  }
}
