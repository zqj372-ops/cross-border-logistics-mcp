{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-11/chargeable-weight.schema.json",
  "title": "ChargeableWeight",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actual_weight", "volumetric_weight", "bubble_weight", "customer_chargeable_weight", "supplier_chargeable_weight", "bubble_share_ratio", "method", "rule_version", "source_ref_ids"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/Version" },
    "actual_weight": { "$ref": "common.schema.json#/$defs/WeightMeasurement" },
    "volumetric_weight": { "$ref": "common.schema.json#/$defs/WeightMeasurement" },
    "bubble_weight": { "$ref": "common.schema.json#/$defs/WeightMeasurement" },
    "customer_chargeable_weight": { "$ref": "common.schema.json#/$defs/WeightMeasurement" },
    "supplier_chargeable_weight": { "$ref": "common.schema.json#/$defs/WeightMeasurement" },
    "bubble_share_ratio": { "$ref": "common.schema.json#/$defs/RatioString" },
    "method": { "type": "string", "enum": ["none", "full", "half", "ratio", "fixed_density"] },
    "rule_version": { "$ref": "common.schema.json#/$defs/Version" },
    "source_ref_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/Identifier" }, "uniqueItems": true }
  }
}
