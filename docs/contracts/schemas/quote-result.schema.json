{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-11/quote-result.schema.json",
  "title": "QuoteResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "quote_id", "quote_status", "currency", "total", "line_items", "rule_version", "data_version", "sendable", "source_ref_ids"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/Version" },
    "quote_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "quote_status": { "type": "string", "enum": ["calculated", "not_calculable", "manual_review", "draft_saved"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "total": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Money" }, { "type": "null" }] },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id", "label", "amount", "pricing_basis", "source_ref_ids"],
        "properties": {
          "line_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "amount": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Money" }, { "type": "null" }] },
          "pricing_basis": { "type": "string", "minLength": 1, "maxLength": 500 },
          "source_ref_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Identifier" }, "uniqueItems": true }
        }
      }
    },
    "rule_version": { "$ref": "common.schema.json#/$defs/Version" },
    "data_version": { "$ref": "common.schema.json#/$defs/Version" },
    "sendable": { "const": false },
    "valid_from": { "oneOf": [{ "$ref": "common.schema.json#/$defs/DateTime" }, { "type": "null" }] },
    "valid_to": { "oneOf": [{ "$ref": "common.schema.json#/$defs/DateTime" }, { "type": "null" }] },
    "source_ref_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/Identifier" }, "uniqueItems": true }
  }
}
