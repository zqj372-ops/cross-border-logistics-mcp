{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts",
    "deploy/cli/**/*.ts",
    "apps/inquiry/**/*.ts",
    "apps/**/*.d.ts",
    "apps/**/*.d.mts",
    "vitest.config.ts",
    "deploy/scripts/start-portal-fixture.ts",
    "deploy/scripts/generate-business-schemas.ts",
    "deploy/scripts/generate-portal-openapi.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
