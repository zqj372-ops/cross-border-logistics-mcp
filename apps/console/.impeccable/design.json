      "css": ".ds-card{display:flex;flex-direction:column;padding:23px;min-height:236px;text-align:left;background:#fff;border:1px solid #e3e7ef;border-radius:12px;color:var(--ink,#202939);font-family:var(--font,Inter,\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif);transition:border-color 180ms ease,background-color 180ms ease;cursor:pointer}.ds-card:hover{background:#fcfdff;border-color:#aebfe7}.ds-card:focus-visible{outline:3px solid #bdcdf7;outline-offset:3px}.ds-card h3{margin:0;font-size:17px;font-weight:650;line-height:1.5}.ds-card p{color:#637087;font-size:13px;line-height:1.8;margin:9px 0 0;flex:1}.ds-card span{color:#6c7990;font-size:11px;margin-top:23px}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
