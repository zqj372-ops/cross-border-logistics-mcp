{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-21/agent-workstreams.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "workstreams", "escalation"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schema_version": {"type": "string", "const": "2026-08-21.v1"},
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workstream_id", "owner", "writable_paths", "primary_delivery"],
        "properties": {
          "workstream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "owner": {"type": "string", "minLength": 1, "maxLength": 80},
          "writable_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "primary_delivery": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "escalation": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
