{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.invalid/schemas/admin-control/plugin-config-state.schema.json",
  "title": "Plugin configuration state v1",
  "oneOf": [
    { "$ref": "#/$defs/configured" },
    { "$ref": "#/$defs/unsupported" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^mcp-plugin-config-hash/v1/[a-z_]+/sha256:[a-f0-9]{64}$"
    },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 64 },
    "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "typedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "value"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "const": "integer" },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "value"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "value"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "enum": ["enum", "secret_slot"] },
            "value": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "label", "description", "restart_policy", "unit", "minimum", "maximum"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "const": "integer" },
            "label": { "type": "string", "minLength": 1, "maxLength": 128 },
            "description": { "type": "string", "minLength": 1, "maxLength": 512 },
            "restart_policy": { "const": "restart_required" },
            "unit": { "enum": ["ms", "attempts"] },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "label", "description", "restart_policy"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "const": "boolean" },
            "label": { "type": "string", "minLength": 1, "maxLength": 128 },
            "description": { "type": "string", "minLength": 1, "maxLength": 512 },
            "restart_policy": { "const": "restart_required" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "label", "description", "restart_policy", "allowed_options"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "const": "enum" },
            "label": { "type": "string", "minLength": 1, "maxLength": 128 },
            "description": { "type": "string", "minLength": 1, "maxLength": 512 },
            "restart_policy": { "const": "restart_required" },
            "allowed_options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/option" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "kind", "label", "description", "restart_policy", "allowed_slots"],
          "properties": {
            "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "kind": { "const": "secret_slot" },
            "label": { "type": "string", "minLength": 1, "maxLength": 128 },
            "description": { "type": "string", "minLength": 1, "maxLength": 512 },
            "restart_policy": { "const": "restart_required" },
            "allowed_slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/option" }
            }
          }
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "scope", "production_eligible", "manual_review", "fields"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "const": "freightcom-ltl" },
        "scope": { "const": "deployment" },
        "production_eligible": { "const": false },
        "manual_review": { "const": true },
        "fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readback_id", "release_id", "revision", "config_digest", "module_generation", "status", "checked_at"],
      "properties": {
        "readback_id": { "$ref": "#/$defs/identifier" },
        "release_id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "config_digest": { "$ref": "#/$defs/hash" },
        "module_generation": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "status": { "enum": ["verified", "mismatch", "unknown"] },
        "checked_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "base_revision", "config_digest", "validation_status", "created_at"],
      "properties": {
        "validation_id": { "$ref": "#/$defs/identifier" },
        "base_revision": { "type": "integer", "minimum": 0 },
        "config_digest": { "$ref": "#/$defs/hash" },
        "validation_status": { "enum": ["validated", "blocked"] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_ref", "intent", "base_revision", "config_digest", "changed_field_ids", "expires_at", "creator_actor_id", "consumed"],
      "properties": {
        "preview_ref": { "$ref": "#/$defs/identifier" },
        "intent": { "enum": ["change", "rollback"] },
        "base_revision": { "type": "integer", "minimum": 0 },
        "config_digest": { "$ref": "#/$defs/hash" },
        "changed_field_ids": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "creator_actor_id": { "$ref": "#/$defs/identifier" },
        "consumed": { "type": "boolean" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "preview_ref", "decision", "approver_actor_id", "decided_at", "reason_code"],
      "properties": {
        "approval_id": { "$ref": "#/$defs/identifier" },
        "preview_ref": { "$ref": "#/$defs/identifier" },
        "decision": { "enum": ["approve", "reject"] },
        "approver_actor_id": { "$ref": "#/$defs/identifier" },
        "decided_at": { "$ref": "#/$defs/timestamp" },
        "reason_code": { "$ref": "#/$defs/reasonCode" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "revision", "intent", "config_digest", "state", "published_at"],
      "properties": {
        "release_id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "intent": { "enum": ["change", "rollback"] },
        "config_digest": { "$ref": "#/$defs/hash" },
        "state": { "enum": ["published_pending_apply", "applying", "restarting", "readback_verified", "manual_review", "blocked", "unavailable", "superseded"] },
        "published_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_id", "action", "object_ref", "status", "occurred_at"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "$ref": "#/$defs/identifier" },
        "action": { "$ref": "#/$defs/reasonCode" },
        "object_ref": { "$ref": "#/$defs/identifier" },
        "status": { "$ref": "#/$defs/reasonCode" },
        "occurred_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "configured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "status", "config_spec", "current_revision", "current_config_digest", "current_module_generation", "current_values", "current_readback", "latest_validation", "latest_preview", "latest_approval", "latest_release", "allowed_actions", "reason_codes", "events", "events_truncated"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "const": "freightcom-ltl" },
        "status": { "enum": ["success", "manual_review", "blocked", "unavailable"] },
        "config_spec": { "$ref": "#/$defs/spec" },
        "current_revision": { "type": "integer", "minimum": 0 },
        "current_config_digest": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "current_module_generation": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "current_values": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/typedValue" } },
        "current_readback": { "anyOf": [{ "$ref": "#/$defs/readback" }, { "type": "null" }] },
        "latest_validation": { "anyOf": [{ "$ref": "#/$defs/validation" }, { "type": "null" }] },
        "latest_preview": { "anyOf": [{ "$ref": "#/$defs/preview" }, { "type": "null" }] },
        "latest_approval": { "anyOf": [{ "$ref": "#/$defs/approval" }, { "type": "null" }] },
        "latest_release": { "anyOf": [{ "$ref": "#/$defs/release" }, { "type": "null" }] },
        "allowed_actions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/reasonCode" } },
        "reason_codes": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/reasonCode" } },
        "events": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/event" } },
        "events_truncated": { "type": "boolean" }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "status", "config_spec", "current_revision", "current_config_digest", "current_module_generation", "current_values", "current_readback", "latest_validation", "latest_preview", "latest_approval", "latest_release", "allowed_actions", "reason_codes", "events", "events_truncated"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "enum": ["cargo", "container", "agent-access"] },
        "status": { "const": "success" },
        "config_spec": { "type": "null" },
        "current_revision": { "const": 0 },
        "current_config_digest": { "type": "null" },
        "current_module_generation": { "type": "null" },
        "current_values": { "type": "array", "maxItems": 0 },
        "current_readback": { "type": "null" },
        "latest_validation": { "type": "null" },
        "latest_preview": { "type": "null" },
        "latest_approval": { "type": "null" },
        "latest_release": { "type": "null" },
        "allowed_actions": { "type": "array", "maxItems": 0 },
        "reason_codes": { "const": ["plugin_config_not_supported"] },
        "events": { "type": "array", "maxItems": 0 },
        "events_truncated": { "const": false }
      }
    }
  }
}
