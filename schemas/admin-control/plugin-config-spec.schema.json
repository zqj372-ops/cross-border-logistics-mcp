{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.invalid/schemas/admin-control/plugin-config-spec.schema.json",
  "title": "Plugin configuration registry v1",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": { "$ref": "#/$defs/registryEntry" },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "integerField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "label", "description", "restart_policy", "unit", "minimum", "maximum"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "integer" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "restart_policy": { "const": "restart_required" },
        "unit": { "enum": ["ms", "attempts"] },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    },
    "booleanField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "label", "description", "restart_policy"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "restart_policy": { "const": "restart_required" }
      }
    },
    "enumField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "label", "description", "restart_policy", "allowed_options"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "enum" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "restart_policy": { "const": "restart_required" },
        "allowed_options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "secretSlotField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "label", "description", "restart_policy", "allowed_slots"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "secret_slot" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "restart_policy": { "const": "restart_required" },
        "allowed_slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "field": {
      "oneOf": [
        { "$ref": "#/$defs/integerField" },
        { "$ref": "#/$defs/booleanField" },
        { "$ref": "#/$defs/enumField" },
        { "$ref": "#/$defs/secretSlotField" }
      ]
    },
    "configSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "scope", "production_eligible", "manual_review", "fields"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "const": "freightcom-ltl" },
        "scope": { "const": "deployment" },
        "production_eligible": { "const": false },
        "manual_review": { "const": true },
        "fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "registryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "config_spec"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "enum": ["cargo", "container", "agent-access", "freightcom-ltl"] },
        "config_spec": {
          "anyOf": [
            { "$ref": "#/$defs/configSpec" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
