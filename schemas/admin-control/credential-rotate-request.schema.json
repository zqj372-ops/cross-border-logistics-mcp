{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-27/admin-control/credential-rotate-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_names", "expires_in_seconds", "reason_code"],
  "properties": {
    "schema_version": {"const": "2026-08-27.v1"},
    "tool_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cargo.calculate",
          "container.plan_summary",
          "system.agent_context.get"
        ]
      }
    },
    "expires_in_seconds": {"type": "integer", "minimum": 900, "maximum": 2592000},
    "reason_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
