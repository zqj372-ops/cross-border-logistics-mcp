{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "selection": {
      "default": "published",
      "type": "string",
      "enum": [
        "published",
        "draft"
      ]
    },
    "collection": {
      "default": "nomenclature",
      "type": "string",
      "enum": [
        "nomenclature",
        "tariffs",
        "measures",
        "requirements",
        "sources"
      ]
    },
    "country": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "CN",
        "US",
        "CA"
      ]
    },
    "query": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "limit": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "selection",
    "collection",
    "country",
    "query",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
