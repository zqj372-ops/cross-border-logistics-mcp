{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preview_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirmation": {
      "type": "string",
      "const": "reviewed_sources_and_conditions"
    }
  },
  "required": [
    "expected_version",
    "preview_hash",
    "confirmation"
  ],
  "additionalProperties": false
}
