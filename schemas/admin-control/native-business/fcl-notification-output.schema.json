{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-notification@2026-09-21.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "recipient": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 254
                },
                {
                  "type": "null"
                }
              ]
            },
            "cc": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 254
              }
            }
          },
          "required": [
            "enabled",
            "recipient",
            "cc"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "replay": {
      "type": "object",
      "properties": {
        "replayed": {
          "type": "boolean"
        },
        "submitted_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": [
        "replayed",
        "submitted_version",
        "current"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "version",
    "input",
    "replay"
  ],
  "additionalProperties": false
}
