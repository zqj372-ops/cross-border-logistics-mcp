{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "table": {
      "default": "rates",
      "type": "string",
      "enum": [
        "rates",
        "zones"
      ]
    },
    "selection": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "table",
    "selection"
  ],
  "additionalProperties": false
}
