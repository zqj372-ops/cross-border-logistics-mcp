{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "credential": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4096,
      "pattern": "^[^\\s]+$"
    },
    "confirmation": {
      "type": "string",
      "const": "use_for_current_organization"
    }
  },
  "required": [
    "expected_version",
    "label",
    "credential",
    "confirmation"
  ],
  "additionalProperties": false
}
