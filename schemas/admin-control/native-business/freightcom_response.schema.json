{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "portal-native-admin@2026-09-07.v1"
    },
    "status": {
      "type": "string",
      "const": "success"
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "label": {
          "type": "string"
        },
        "credential_present": {
          "type": "boolean"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string",
          "const": "Freightcom"
        },
        "live_rate_verified": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "version",
        "label",
        "credential_present",
        "updated_at",
        "provider",
        "live_rate_verified"
      ],
      "additionalProperties": false
    },
    "reason_codes": {
      "minItems": 0,
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "data",
    "reason_codes"
  ],
  "additionalProperties": false
}
