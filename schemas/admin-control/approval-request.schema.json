{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-22/admin-control/approval-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preview_ref", "decision", "reason_code"],
  "properties": {
    "schema_version": {"const": "2026-08-22.v1"},
    "preview_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "decision": {"enum": ["approve", "reject"]},
    "reason_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
