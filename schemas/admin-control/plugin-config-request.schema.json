{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.invalid/schemas/admin-control/plugin-config-request.schema.json",
  "title": "Plugin configuration write request v1",
  "oneOf": [
    { "$ref": "#/$defs/validateDraft" },
    { "$ref": "#/$defs/changePreview" },
    { "$ref": "#/$defs/rollbackPreview" },
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/publish" },
    { "$ref": "#/$defs/reconcile" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "moduleId": {
      "enum": ["cargo", "container", "agent-access", "freightcom-ltl"]
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "value"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "integer" },
        "value": { "type": "integer" }
      }
    },
    "booleanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "value"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" }
      }
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "value"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "enum" },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "secretSlotValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "kind", "value"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "const": "secret_slot" },
        "value": { "$ref": "#/$defs/identifier" }
      }
    },
    "typedValue": {
      "oneOf": [
        { "$ref": "#/$defs/integerValue" },
        { "$ref": "#/$defs/booleanValue" },
        { "$ref": "#/$defs/enumValue" },
        { "$ref": "#/$defs/secretSlotValue" }
      ]
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/typedValue" }
    },
    "validateDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "base_revision", "values"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "$ref": "#/$defs/moduleId" },
        "base_revision": { "type": "integer", "minimum": 0 },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "changePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "intent", "base_revision", "values"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "$ref": "#/$defs/moduleId" },
        "intent": { "const": "change" },
        "base_revision": { "type": "integer", "minimum": 0 },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "rollbackPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "intent", "target_release_id"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "$ref": "#/$defs/moduleId" },
        "intent": { "const": "rollback" },
        "target_release_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "preview_ref", "decision", "reason_code"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "$ref": "#/$defs/moduleId" },
        "preview_ref": { "$ref": "#/$defs/identifier" },
        "decision": { "enum": ["approve", "reject"] },
        "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "preview_ref", "approval_id"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "$ref": "#/$defs/moduleId" },
        "preview_ref": { "$ref": "#/$defs/identifier" },
        "approval_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module_id", "release_id"],
      "properties": {
        "schema_version": { "const": "2026-08-31.v1" },
        "module_id": { "$ref": "#/$defs/moduleId" },
        "release_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
