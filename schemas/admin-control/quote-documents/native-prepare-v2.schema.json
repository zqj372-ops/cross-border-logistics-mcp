{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "inquiry-quote-link@2026-09-13.v1"
    },
    "case_ref": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "expected_customer_event_ref": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "address_line": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "postal_code": {
          "type": "string",
          "pattern": "^[A-Za-z]\\d[A-Za-z][ -]?\\d[A-Za-z]\\d$"
        },
        "city": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "province": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "cbm": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "weight_kg": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "piece_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packaging_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "longest_side_cm": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "address_type": {
          "type": "string",
          "enum": [
            "commercial",
            "residential",
            "private",
            "rural_residential"
          ]
        },
        "requires_liftgate": {
          "type": "boolean"
        },
        "requires_pallet_jack": {
          "type": "boolean"
        },
        "requires_appointment": {
          "type": "boolean"
        },
        "explicit_pallet_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "is_stackable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "detention_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object",
          "properties": {
            "cargo_lines_v1": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "packaging_type": {
                    "type": "string",
                    "enum": [
                      "carton",
                      "crate",
                      "pallet",
                      "bag",
                      "other"
                    ]
                  },
                  "length_cm": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,8})?$"
                  },
                  "width_cm": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,8})?$"
                  },
                  "height_cm": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,8})?$"
                  },
                  "weight": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "unit_weight",
                          "line_total_weight"
                        ]
                      },
                      "value_kg": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,8})?$"
                      }
                    },
                    "required": [
                      "mode",
                      "value_kg"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "quantity",
                  "packaging_type",
                  "length_cm",
                  "width_cm",
                  "height_cm",
                  "weight"
                ],
                "additionalProperties": false
              }
            },
            "origin_v1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "postal_code",
        "cbm",
        "weight_kg",
        "piece_count",
        "packaging_type",
        "address_type",
        "requires_liftgate",
        "requires_pallet_jack",
        "requires_appointment",
        "explicit_pallet_count",
        "is_stackable",
        "detention_minutes"
      ],
      "additionalProperties": false
    },
    "customer": {
      "type": "object",
      "properties": {
        "quote_no": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "quote_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "valid_until": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "job_no": {
          "type": "string",
          "maxLength": 80
        },
        "so_no": {
          "type": "string",
          "maxLength": 80
        },
        "container_no": {
          "type": "string",
          "maxLength": 80
        },
        "remark": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "quote_no",
        "customer_name",
        "quote_date",
        "valid_until",
        "job_no",
        "so_no",
        "container_no",
        "remark"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "case_ref",
    "expected_customer_event_ref",
    "request",
    "customer"
  ],
  "additionalProperties": false
}
