{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote_ref": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "current_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "case_ref": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "case_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rate_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "release_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "complete": {
            "type": "boolean"
          },
          "by_currency": {
            "type": "object",
            "properties": {
              "USD": {
                "type": "object",
                "properties": {
                  "cost_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "revenue_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "gp_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "margin": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,6})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "cost_subtotal",
                  "revenue_subtotal",
                  "gp_subtotal",
                  "margin",
                  "complete"
                ],
                "additionalProperties": false
              },
              "CAD": {
                "type": "object",
                "properties": {
                  "cost_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "revenue_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "gp_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "margin": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,6})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "cost_subtotal",
                  "revenue_subtotal",
                  "gp_subtotal",
                  "margin",
                  "complete"
                ],
                "additionalProperties": false
              },
              "CNY": {
                "type": "object",
                "properties": {
                  "cost_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "revenue_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "gp_subtotal": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "margin": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,6})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "cost_subtotal",
                  "revenue_subtotal",
                  "gp_subtotal",
                  "margin",
                  "complete"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "USD",
              "CAD",
              "CNY"
            ],
            "additionalProperties": false
          },
          "currentness": {
            "type": "object",
            "properties": {
              "valid_now": {
                "type": "boolean"
              },
              "reason_codes": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "required": [
              "valid_now",
              "reason_codes"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "quote_ref",
          "version",
          "current_version",
          "case_ref",
          "case_version",
          "rate_id",
          "release_id",
          "complete",
          "by_currency",
          "currentness",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
