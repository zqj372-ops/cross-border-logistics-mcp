{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-document-workflow@2026-09-20.v1"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "issuer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issuer_address": {
          "type": "string",
          "maxLength": 500
        },
        "issuer_phone": {
          "type": "string",
          "maxLength": 50
        },
        "issuer_email": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "maxLength": 254,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            }
          ]
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "standard_fee_template_v1": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "template_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,63}$"
                },
                "template_version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "items": {
                  "maxItems": 60,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item_key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{2,63}$"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "description": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 500
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "unit_suggestion": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 20
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "quantity_suggestion": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "display": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "detail",
                              "hiddenIncluded",
                              "hiddenExcluded",
                              "merged"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "item_key",
                      "name",
                      "description",
                      "unit_suggestion",
                      "quantity_suggestion",
                      "display"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "template_id",
                "template_version",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issuer_name",
        "issuer_address",
        "issuer_phone",
        "issuer_email",
        "terms",
        "standard_fee_template_v1"
      ],
      "additionalProperties": false
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "expected_version",
    "input",
    "confirmed"
  ],
  "additionalProperties": false
}
