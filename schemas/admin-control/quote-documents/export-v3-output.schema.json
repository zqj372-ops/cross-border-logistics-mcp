{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "draft",
        "formal",
        "history"
      ]
    },
    "draft": {
      "type": "boolean"
    },
    "historical": {
      "type": "boolean"
    },
    "valid_now": {
      "type": "boolean"
    },
    "target_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "filename": {
      "type": "string",
      "pattern": "^quotation-[a-f0-9-]+-v[0-9]+\\.pdf$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 100,
      "maximum": 8388608
    },
    "content_base64": {
      "type": "string",
      "maxLength": 11184812,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "totals": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "partial": {
              "type": "boolean"
            },
            "complete": {
              "type": "boolean"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "source_kind": {
                    "type": "string",
                    "enum": [
                      "manual",
                      "template",
                      "native"
                    ]
                  },
                  "template_ref": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "template_id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{2,63}$"
                          },
                          "template_version": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "item_key": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{2,63}$"
                          }
                        },
                        "required": [
                          "template_id",
                          "template_version",
                          "item_key"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "group": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "A",
                          "B",
                          "C"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_price": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "currency": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "USD",
                          "CAD",
                          "CNY"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "display": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "detail",
                          "hiddenIncluded",
                          "hiddenExcluded",
                          "merged"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "merge_name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "source_kind",
                  "template_ref",
                  "name",
                  "description",
                  "group",
                  "quantity",
                  "unit",
                  "unit_price",
                  "currency",
                  "display",
                  "merge_name",
                  "note",
                  "amount"
                ],
                "additionalProperties": false
              }
            },
            "by_currency": {
              "type": "object",
              "properties": {
                "USD": {
                  "type": "string"
                },
                "CAD": {
                  "type": "string"
                },
                "CNY": {
                  "type": "string"
                }
              },
              "required": [
                "USD",
                "CAD",
                "CNY"
              ],
              "additionalProperties": false
            },
            "total_cny": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_usd": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "calculation_version": {
              "type": "string",
              "const": "quote-documents-decimal-v1"
            }
          },
          "required": [
            "partial",
            "complete",
            "rows",
            "by_currency",
            "total_cny",
            "total_usd",
            "warnings",
            "calculation_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "revision_id",
    "current_version",
    "mode",
    "draft",
    "historical",
    "valid_now",
    "target_version",
    "filename",
    "sha256",
    "byte_length",
    "content_base64",
    "totals"
  ],
  "additionalProperties": false
}
