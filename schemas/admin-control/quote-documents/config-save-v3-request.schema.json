{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "quote-documents-workflow@2026-09-15.v1"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "company_address": {
          "type": "string",
          "maxLength": 500
        },
        "company_phone": {
          "type": "string",
          "maxLength": 50
        },
        "company_email": {
          "type": "string",
          "maxLength": 254
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "fee_items": {
          "maxItems": 60,
          "type": "array",
          "items": {}
        },
        "standard_fee_template_v1": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            },
            "template_version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "items": {
              "maxItems": 60,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,63}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit_suggestion": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quantity_suggestion": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "display": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "detail",
                          "hiddenIncluded",
                          "hiddenExcluded",
                          "merged"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "item_key",
                  "name",
                  "description",
                  "unit_suggestion",
                  "quantity_suggestion",
                  "display"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "template_id",
            "template_version",
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "company_name",
        "company_address",
        "company_phone",
        "company_email",
        "terms",
        "fee_items"
      ],
      "additionalProperties": false
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "expected_version",
    "input",
    "confirmed"
  ],
  "additionalProperties": false
}
