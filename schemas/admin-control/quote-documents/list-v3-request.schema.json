{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "quote-documents-workflow@2026-09-15.v1"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "filters": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "all",
            "draft",
            "approved",
            "rejected"
          ]
        },
        "quote_no": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "customer_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "quote_no",
        "customer_name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "limit",
    "filters"
  ],
  "additionalProperties": false
}
