{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "quote-documents@2026-09-13.v2"
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_input",
        "blocked",
        "unavailable"
      ]
    },
    "data": {
      "type": "null"
    },
    "reason_codes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,127}$"
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "data",
    "reason_codes"
  ],
  "additionalProperties": false
}
