{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "company_address": {
          "type": "string",
          "maxLength": 500
        },
        "company_phone": {
          "type": "string",
          "maxLength": 50
        },
        "company_email": {
          "type": "string",
          "maxLength": 254
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "fee_items": {
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 500
              },
              "group": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              "quantity": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "unit_price": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "CAD",
                  "CNY"
                ]
              },
              "display": {
                "type": "string",
                "enum": [
                  "detail",
                  "hiddenIncluded",
                  "hiddenExcluded",
                  "merged"
                ]
              },
              "merge_name": {
                "default": "",
                "type": "string",
                "maxLength": 200
              },
              "note": {
                "default": "",
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "group",
              "quantity",
              "unit",
              "unit_price",
              "currency",
              "display",
              "merge_name",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "company_name",
        "company_address",
        "company_phone",
        "company_email",
        "terms",
        "fee_items"
      ],
      "additionalProperties": false
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "expected_version",
    "input",
    "confirmed"
  ],
  "additionalProperties": false
}
