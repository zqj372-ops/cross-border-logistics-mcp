                          "type": "null"
                        }
                      ]
                    },
                    "unit_suggestion": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 20
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "quantity_suggestion": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "display": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "detail",
                            "hiddenIncluded",
                            "hiddenExcluded",
                            "merged"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
