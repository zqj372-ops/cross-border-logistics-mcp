{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "quote-documents-workflow@2026-09-15.v1"
    },
    "input": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "quote-document-draft@2026-09-15.v1"
        },
        "quote_no": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "customer_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "quote_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "route_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "job_no": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "so_no": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "container_no": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "remark": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "exchange_rates": {
          "type": "object",
          "properties": {
            "USD": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "CAD": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "USD",
            "CAD"
          ],
          "additionalProperties": false
        },
        "fee_items": {
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "source_kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "template",
                  "native"
                ]
              },
              "template_ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "template_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{2,63}$"
                      },
                      "template_version": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "item_key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{2,63}$"
                      }
                    },
                    "required": [
                      "template_id",
                      "template_version",
                      "item_key"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "group": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "A",
                      "B",
                      "C"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 20
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_price": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "currency": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "USD",
                      "CAD",
                      "CNY"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "detail",
                      "hiddenIncluded",
                      "hiddenExcluded",
                      "merged"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "merge_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "source_kind",
              "template_ref",
              "name",
              "description",
              "group",
              "quantity",
              "unit",
              "unit_price",
              "currency",
              "display",
              "merge_name",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "quote_no",
        "customer_name",
        "quote_date",
        "valid_until",
        "origin",
        "destination",
        "route_name",
        "job_no",
        "so_no",
        "container_no",
        "remark",
        "exchange_rates",
        "fee_items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "input"
  ],
  "additionalProperties": false
}
