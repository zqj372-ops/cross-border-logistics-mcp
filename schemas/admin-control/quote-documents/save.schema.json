{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "quote_no": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "quote_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "valid_until": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "origin": {
          "type": "string",
          "maxLength": 200
        },
        "destination": {
          "type": "string",
          "maxLength": 200
        },
        "route_name": {
          "type": "string",
          "maxLength": 200
        },
        "job_no": {
          "type": "string",
          "maxLength": 80
        },
        "so_no": {
          "type": "string",
          "maxLength": 80
        },
        "container_no": {
          "type": "string",
          "maxLength": 80
        },
        "remark": {
          "type": "string",
          "maxLength": 4000
        },
        "exchange_rates": {
          "type": "object",
          "properties": {
            "USD": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "CAD": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "USD",
            "CAD"
          ],
          "additionalProperties": false
        },
        "fee_items": {
          "minItems": 1,
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 500
              },
              "group": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              "quantity": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "unit_price": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,9})(?:\\.[0-9]{1,6})?$"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "CAD",
                  "CNY"
                ]
              },
              "display": {
                "type": "string",
                "enum": [
                  "detail",
                  "hiddenIncluded",
                  "hiddenExcluded",
                  "merged"
                ]
              },
              "merge_name": {
                "default": "",
                "type": "string",
                "maxLength": 200
              },
              "note": {
                "default": "",
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "group",
              "quantity",
              "unit",
              "unit_price",
              "currency",
              "display",
              "merge_name",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "quote_no",
        "customer_name",
        "quote_date",
        "valid_until",
        "origin",
        "destination",
        "route_name",
        "job_no",
        "so_no",
        "container_no",
        "remark",
        "exchange_rates",
        "fee_items"
      ],
      "additionalProperties": false
    },
    "template_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "preview_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preview_expires_at": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "input",
    "template_version",
    "preview_hash",
    "preview_expires_at",
    "confirmed"
  ],
  "additionalProperties": false
}
