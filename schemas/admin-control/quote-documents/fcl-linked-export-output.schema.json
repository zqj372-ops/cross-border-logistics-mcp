{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-document-workflow@2026-09-20.v1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "current_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "formal",
        "history"
      ]
    },
    "historical": {
      "type": "boolean"
    },
    "valid_now": {
      "type": "boolean"
    },
    "filename": {
      "type": "string",
      "pattern": "^fcl-[a-f0-9-]+-v[0-9]+\\.pdf$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 100,
      "maximum": 8388608
    },
    "content_base64": {
      "type": "string",
      "maxLength": 11184812,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "customer_totals": {
      "type": "object",
      "properties": {
        "by_currency": {
          "type": "object",
          "properties": {
            "USD": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
            },
            "CAD": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
            },
            "CNY": {
              "type": "string",
              "pattern": "^(?:0|[1-9]\\d{0,31})(?:\\.\\d{1,2})?$"
            }
          },
          "required": [
            "USD",
            "CAD",
            "CNY"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "by_currency"
      ],
      "additionalProperties": false
    },
    "trace_refs": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "replay": {
      "type": "object",
      "properties": {
        "replayed": {
          "type": "boolean"
        },
        "submitted_version": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "type": "boolean"
        }
      },
      "required": [
        "replayed",
        "submitted_version",
        "current"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "document_id",
    "version",
    "revision_id",
    "current_version",
    "mode",
    "historical",
    "valid_now",
    "filename",
    "sha256",
    "byte_length",
    "content_base64",
    "customer_totals",
    "trace_refs",
    "replay"
  ],
  "additionalProperties": false
}
