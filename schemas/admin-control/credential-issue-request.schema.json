{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/logistics-mcp/2026-08-27/admin-control/credential-issue-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "client_id", "label", "tool_names", "expires_in_seconds"],
  "properties": {
    "schema_version": {"const": "2026-08-27.v1"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "client_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 120},
    "tool_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cargo.calculate",
          "container.plan_summary",
          "system.agent_context.get"
        ]
      }
    },
    "expires_in_seconds": {"type": "integer", "minimum": 900, "maximum": 2592000}
  }
}
