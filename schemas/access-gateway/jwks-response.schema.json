{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logistics-mcp.invalid/access-gateway/jwks-response.schema.json",
  "title": "Unified Access Gateway JSON Web Key Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rsa_public_jwk"
      }
    }
  },
  "$defs": {
    "rsa_public_jwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "kid", "alg", "use", "n", "e"],
      "properties": {
        "kty": {
          "const": "RSA"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "alg": {
          "const": "RS256"
        },
        "use": {
          "const": "sig"
        },
        "n": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128,1024}$"
        },
        "e": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,16}$"
        }
      }
    }
  }
}
