{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "submitted",
            "in_review",
            "needs_input",
            "closed",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "limit",
    "status",
    "cursor"
  ],
  "additionalProperties": false,
  "$id": "https://freightclaw.local/schemas/portal-fcl-case-list-query.schema.json"
}
