{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.local/schemas/provider-release.schema.json",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "provider-release@2026-09-06.v1"
        },
        "module_id": {
          "type": "string",
          "const": "business-api"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "enabled": {
          "type": "boolean"
        },
        "artifact_file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}\\.json$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sbom_file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}\\.json$"
        },
        "sbom_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
        }
      },
      "required": [
        "schema_version",
        "module_id",
        "version",
        "revision",
        "enabled",
        "artifact_file",
        "artifact_digest",
        "sbom_file",
        "sbom_digest",
        "source_commit",
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "alg": {
      "type": "string",
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "payload",
    "alg",
    "key_id",
    "signature"
  ],
  "additionalProperties": false
}
