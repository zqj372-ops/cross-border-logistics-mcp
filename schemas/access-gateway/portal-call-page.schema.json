{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.local/schemas/portal-call-page.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "portal-call-log@2026-09-06.v1"
    },
    "status": {
      "type": "string",
      "const": "success"
    },
    "data": {
      "type": "object",
      "properties": {
        "events": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "tenant_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "client_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actor_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "cargo.calculate",
                  "container.plan_summary",
                  "system.agent_context.get",
                  "customs.query",
                  "customs.tax.estimate",
                  "quote.zone_preview",
                  "quote.ai_extract_preview",
                  "quote.freightcom_ltl.preview"
                ]
              },
              "request_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "needs_input",
                  "manual_review",
                  "blocked",
                  "unavailable"
                ]
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              },
              "created_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
              }
            },
            "required": [
              "event_id",
              "tenant_id",
              "client_id",
              "actor_ref",
              "operation",
              "request_id",
              "status",
              "duration_ms",
              "created_at"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "status_counts": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "needs_input": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "manual_review": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unavailable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "success",
                "needs_input",
                "manual_review",
                "blocked",
                "unavailable"
              ],
              "additionalProperties": false
            },
            "average_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "status_counts",
            "average_duration_ms"
          ],
          "additionalProperties": false
        },
        "window": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
            },
            "retention_days": {
              "type": "number",
              "const": 30
            },
            "maximum_events_per_tenant": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "from",
            "to",
            "retention_days",
            "maximum_events_per_tenant"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "events",
        "next_cursor",
        "summary",
        "window"
      ],
      "additionalProperties": false
    },
    "reason_codes": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "data",
    "reason_codes"
  ],
  "additionalProperties": false
}
