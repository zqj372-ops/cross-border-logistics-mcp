{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-inquiry@2026-09-20.v1"
    },
    "transport_mode": {
      "type": "string",
      "const": "FCL"
    },
    "origin_city": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pol": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pod": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_destination": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cargo_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "containers": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "20GP",
              "40GP",
              "40HQ",
              "45HQ"
            ]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "type",
          "quantity"
        ],
        "additionalProperties": false
      }
    },
    "cargo_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "general",
            "battery",
            "liquid_powder",
            "wood",
            "regulated",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "estimated_weight": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^(?=[\\s\\S]*[1-9])\\d{1,10}(?:\\.\\d{1,6})?$"
            },
            "unit": {
              "type": "string",
              "const": "kg"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "cargo_ready_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "incoterm": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "EXW",
            "FOB",
            "CIF",
            "DDU",
            "DDP",
            "Other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "incoterm_other": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_services": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pickup",
          "export_customs",
          "ocean_freight",
          "canada_customs",
          "devanning_storage",
          "delivery"
        ]
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        "company": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "company",
        "email",
        "phone"
      ],
      "additionalProperties": false
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "consent": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "transport_mode",
    "origin_city",
    "pol",
    "pod",
    "final_destination",
    "cargo_name",
    "containers",
    "cargo_type",
    "estimated_weight",
    "cargo_ready_date",
    "incoterm",
    "incoterm_other",
    "selected_services",
    "contact",
    "notes",
    "consent"
  ],
  "additionalProperties": false,
  "$id": "https://freightclaw.local/schemas/portal-fcl-inquiry-input.schema.json"
}
