{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.local/schemas/customs-history-list-response.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "customs-history@2026-09-06.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "actor_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "needs_input",
        "manual_review",
        "blocked",
        "unavailable"
      ]
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "records": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "record_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "customs.query",
                      "customs.tax.estimate"
                    ]
                  },
                  "created_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "success",
                      "needs_input",
                      "manual_review",
                      "blocked",
                      "unavailable"
                    ]
                  },
                  "data_version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  }
                },
                "required": [
                  "record_ref",
                  "operation",
                  "created_at",
                  "status",
                  "data_version"
                ],
                "additionalProperties": false
              }
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "records",
            "next_cursor"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "tenant_id",
    "actor_ref",
    "application_id",
    "status",
    "data",
    "reason_codes"
  ],
  "additionalProperties": false
}
