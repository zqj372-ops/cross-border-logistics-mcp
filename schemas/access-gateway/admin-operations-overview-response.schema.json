{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.net/schemas/access-gateway/admin-operations-overview-response.schema.json",
  "title": "Access Gateway administrator operations overview response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "data", "warnings", "blockers"],
  "properties": {
    "schema_version": { "const": "2026-08-30.v1" },
    "status": { "const": "success" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "access_state", "gateway_activity", "agent_onboarding"],
      "properties": {
        "generated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "access_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenants", "clients", "credentials"],
          "properties": {
            "tenants": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total", "active", "suspended"],
              "properties": {
                "total": { "$ref": "#/$defs/count" },
                "active": { "$ref": "#/$defs/count" },
                "suspended": { "$ref": "#/$defs/count" }
              }
            },
            "clients": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total", "active", "disabled"],
              "properties": {
                "total": { "$ref": "#/$defs/count" },
                "active": { "$ref": "#/$defs/count" },
                "disabled": { "$ref": "#/$defs/count" }
              }
            },
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "active",
                "pending_delivery",
                "tenant_suspended",
                "client_disabled",
                "expired",
                "revoked"
              ],
              "properties": {
                "total": { "$ref": "#/$defs/count" },
                "active": { "$ref": "#/$defs/count" },
                "pending_delivery": { "$ref": "#/$defs/count" },
                "tenant_suspended": { "$ref": "#/$defs/count" },
                "client_disabled": { "$ref": "#/$defs/count" },
                "expired": { "$ref": "#/$defs/count" },
                "revoked": { "$ref": "#/$defs/count" }
              }
            }
          }
        },
        "gateway_activity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window_started_at",
            "window_seconds",
            "total_audit_events",
            "status_counts",
            "recent_issues"
          ],
          "properties": {
            "window_started_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "window_seconds": { "const": 86400 },
            "total_audit_events": { "$ref": "#/$defs/count" },
            "status_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["success", "needs_input", "manual_review", "blocked", "unavailable"],
              "properties": {
                "success": { "$ref": "#/$defs/count" },
                "needs_input": { "$ref": "#/$defs/count" },
                "manual_review": { "$ref": "#/$defs/count" },
                "blocked": { "$ref": "#/$defs/count" },
                "unavailable": { "$ref": "#/$defs/count" }
              }
            },
            "recent_issues": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["audit_ref", "action", "status", "reason_code", "created_at"],
                "properties": {
                  "audit_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "action": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "status": {
                    "enum": ["needs_input", "manual_review", "blocked", "unavailable"]
                  },
                  "reason_code": {
                    "type": ["string", "null"],
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "created_at": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  }
                }
              }
            }
          }
        },
        "agent_onboarding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported_clients", "token_exchange_path", "mcp_path", "tool_names"],
          "properties": {
            "supported_clients": {
              "const": ["chatgpt-work", "codex", "enterprise-assistant"]
            },
            "token_exchange_path": { "const": "/access/v1/token/exchange" },
            "mcp_path": { "const": "/mcp" },
            "tool_names": {
              "const": [
                "cargo.calculate",
                "container.plan_summary",
                "system.agent_context.get"
              ]
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 0 },
    "blockers": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
