{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.local/schemas/freightcom-ltl-preview-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "data",
    "reason_codes",
    "source_refs",
    "request_id",
    "saved",
    "sendable",
    "bookable"
  ],
  "properties": {
    "schema_version": {
      "const": "portal-freightcom-rate@2026-09-05.v1"
    },
    "status": {
      "enum": [
        "success",
        "needs_input",
        "manual_review",
        "blocked",
        "unavailable"
      ]
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "api_version",
            "environment",
            "rate_request_ref",
            "request_status",
            "rates",
            "read_only",
            "provider_quote_authoritative"
          ],
          "properties": {
            "provider": {
              "const": "freightcom"
            },
            "api_version": {
              "const": "2.10.0"
            },
            "environment": {
              "enum": [
                "production",
                "fixture"
              ]
            },
            "rate_request_ref": {
              "type": "string",
              "pattern": "^freightcom-rate:[a-f0-9]{64}$"
            },
            "request_status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "done",
                "total",
                "complete"
              ],
              "properties": {
                "done": {
                  "type": "boolean"
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "complete": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "rates": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "carrier_name",
                  "service_name",
                  "service_id",
                  "valid_until",
                  "total",
                  "base",
                  "surcharges",
                  "taxes",
                  "transit_time_days",
                  "transit_time_not_available",
                  "transit_time_hours",
                  "carrier_cut_off_time",
                  "estimated_delivery_time",
                  "truck_details_ftl",
                  "transit_mode_ftl",
                  "paperless",
                  "customs_charge_data"
                ],
                "properties": {
                  "carrier_name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "service_name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "service_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "valid_until": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "total": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "currency",
                          "amount",
                          "minor_value"
                        ],
                        "properties": {
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$"
                          },
                          "amount": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "minor_value": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)$"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "base": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "currency",
                          "amount",
                          "minor_value"
                        ],
                        "properties": {
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$"
                          },
                          "amount": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "minor_value": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)$"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "surcharges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "amount"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "amount": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "currency",
                            "amount",
                            "minor_value"
                          ],
                          "properties": {
                            "currency": {
                              "type": "string",
                              "pattern": "^[A-Z]{3}$"
                            },
                            "amount": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "minor_value": {
                              "type": "string",
                              "pattern": "^(0|[1-9][0-9]*)$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "taxes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "amount"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "amount": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "currency",
                            "amount",
                            "minor_value"
                          ],
                          "properties": {
                            "currency": {
                              "type": "string",
                              "pattern": "^[A-Z]{3}$"
                            },
                            "amount": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "minor_value": {
                              "type": "string",
                              "pattern": "^(0|[1-9][0-9]*)$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "transit_time_days": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "transit_time_not_available": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "transit_time_hours": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "carrier_cut_off_time": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "estimated_delivery_time": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "truck_details_ftl": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "transit_mode_ftl": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "paperless": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "customs_charge_data": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "duties_and_taxes_surcharge_keys",
                          "guarantee_fee_surcharge_keys",
                          "carrier_and_government_fees_surcharge_keys",
                          "processing_fees_surcharge_keys",
                          "is_rate_guaranteed"
                        ],
                        "properties": {
                          "duties_and_taxes_surcharge_keys": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "guarantee_fee_surcharge_keys": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "carrier_and_government_fees_surcharge_keys": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "processing_fees_surcharge_keys": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "is_rate_guaranteed": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "read_only": {
              "const": true
            },
            "provider_quote_authoritative": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "system",
          "locator",
          "version",
          "retrieved_at",
          "authority",
          "content_hash"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "source_type": {
            "enum": [
              "official_source",
              "fixture"
            ]
          },
          "system": {
            "const": "Freightcom Customer API"
          },
          "locator": {
            "type": "string",
            "pattern": "^opaque://freightcom/(production|fixture)/rate/[a-f0-9]{64}$"
          },
          "version": {
            "const": "freightcom-api@2.10.0"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T[^\\s]+$"
          },
          "authority": {
            "enum": [
              "authoritative",
              "supporting"
            ]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]{8,128}$"
    },
    "saved": {
      "const": false
    },
    "sendable": {
      "const": false
    },
    "bookable": {
      "const": false
    }
  }
}
