{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "preview_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "expected_version",
    "preview_hash"
  ],
  "additionalProperties": false,
  "$id": "https://freightclaw.local/schemas/portal-channels-publish.schema.json"
}
