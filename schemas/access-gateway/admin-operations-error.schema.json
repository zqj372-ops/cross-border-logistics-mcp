{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightclaw.net/schemas/access-gateway/admin-operations-error.schema.json",
  "title": "Access Gateway administrator operations error response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "data", "reason_codes"],
  "properties": {
    "schema_version": { "const": "2026-08-30.v1" },
    "status": { "enum": ["blocked", "unavailable"] },
    "data": { "type": "null" },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "authentication_failed",
          "management_admin_required",
          "admin_boundary_rejected",
          "method_not_allowed",
          "access_operations_unavailable"
        ]
      }
    }
  }
}
