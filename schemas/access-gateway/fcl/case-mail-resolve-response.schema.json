{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "data": {
          "$ref": "#/$defs/__schema0"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs_input",
            "manual_review"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "blocked",
            "unavailable"
          ]
        },
        "data": {
          "type": "null"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "pre_execution": {
          "type": "object",
          "properties": {
            "owner_id": {
              "$ref": "#/$defs/__schema2"
            },
            "case_version": {
              "$ref": "#/$defs/__schema3"
            },
            "inquiry_no": {
              "type": "string",
              "maxLength": 80
            },
            "customer_name": {
              "type": "string",
              "maxLength": 200
            },
            "route": {
              "type": "string",
              "maxLength": 500
            },
            "notification": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "enum": [
                    "intake",
                    "quote",
                    "customer_followup",
                    "booking",
                    "pickup",
                    "export_customs",
                    "shipping_documents",
                    "canada_customs",
                    "devanning_storage",
                    "delivery"
                  ]
                },
                "assignment": {
                  "type": "object",
                  "properties": {
                    "responsible_id": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/__schema2"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "collaborator_ids": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema2"
                      }
                    },
                    "to": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/__schema4"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "cc": {
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema4"
                      }
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "responsible_id",
                    "collaborator_ids",
                    "to",
                    "cc",
                    "enabled"
                  ],
                  "additionalProperties": false
                },
                "template_version": {
                  "type": "string",
                  "const": "fcl-node-mail@2026-09-23.v1"
                },
                "external_to": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/__schema4"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "external_cc": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema4"
                  }
                },
                "external_enabled": {
                  "type": "boolean"
                },
                "visible_fields": {
                  "maxItems": 17,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                }
              },
              "required": [
                "node_id",
                "assignment",
                "template_version",
                "external_to",
                "external_cc",
                "external_enabled",
                "visible_fields"
              ],
              "additionalProperties": false
            },
            "event_kind": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "owner_id",
            "case_version",
            "inquiry_no",
            "customer_name",
            "route",
            "notification",
            "event_kind"
          ],
          "additionalProperties": false
        },
        "resolutions": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "message_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "case_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "intake",
                "quote",
                "customer_followup",
                "booking",
                "pickup",
                "export_customs",
                "shipping_documents",
                "canada_customs",
                "devanning_storage",
                "delivery"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle": {
          "$ref": "#/$defs/__schema3"
        },
        "audience": {
          "type": "string",
          "enum": [
            "internal",
            "external"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "sending",
            "smtp_accepted",
            "failed",
            "unknown",
            "cancelled"
          ]
        },
        "assignment_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template_version": {
          "type": "string",
          "const": "fcl-node-mail@2026-09-23.v1"
        },
        "to": {
          "$ref": "#/$defs/__schema4"
        },
        "cc": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "lease_token": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema7"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/__schema7"
        },
        "updated_at": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "resolutions",
        "message_id",
        "event_id",
        "case_ref",
        "node_id",
        "cycle",
        "audience",
        "status",
        "assignment_digest",
        "template_version",
        "to",
        "cc",
        "attempts",
        "lease_token",
        "lease_until",
        "result_code",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "carrier",
        "vessel_voyage",
        "booking_so",
        "etd",
        "eta",
        "cutoff",
        "pickup_location",
        "appointment",
        "declaration_ref",
        "release_evidence",
        "warehouse",
        "handover_at",
        "delivery_address",
        "signed_at",
        "empty_return_at"
      ]
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/__schema2"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "at": {
          "$ref": "#/$defs/__schema7"
        },
        "outcome": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "actor_id",
        "reason",
        "at",
        "outcome"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema10": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
