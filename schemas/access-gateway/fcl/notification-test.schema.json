{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "enum": [
        "intake",
        "quote",
        "customer_followup",
        "booking",
        "pickup",
        "export_customs",
        "shipping_documents",
        "canada_customs",
        "devanning_storage",
        "delivery"
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "node_id",
    "audience",
    "expected_version",
    "confirmed"
  ],
  "additionalProperties": false
}
