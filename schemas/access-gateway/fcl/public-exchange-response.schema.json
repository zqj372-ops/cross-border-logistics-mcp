{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "data": {
          "type": "object",
          "properties": {
            "inquiry_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "inquiry_id"
          ],
          "additionalProperties": false
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs_input",
            "manual_review",
            "blocked",
            "unavailable"
          ]
        },
        "data": {
          "type": "null"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    }
  ]
}
