{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "data": {
          "type": "null"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs_input",
            "manual_review",
            "blocked",
            "unavailable"
          ]
        },
        "data": {
          "type": "null"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    }
  ]
}
