{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "data": {
          "$ref": "#/$defs/__schema0"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs_input",
            "manual_review"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "blocked",
            "unavailable"
          ]
        },
        "data": {
          "type": "null"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "can_edit": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema1"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema1"
            },
            {
              "type": "null"
            }
          ]
        },
        "password_present": {
          "type": "boolean"
        },
        "test_status": {
          "type": "string",
          "enum": [
            "not_tested",
            "pending",
            "smtp_accepted",
            "failed",
            "unknown"
          ]
        },
        "test_recipient": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "can_edit",
        "version",
        "active",
        "draft",
        "password_present",
        "test_status",
        "test_recipient"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "port": {
          "anyOf": [
            {
              "type": "number",
              "const": 465
            },
            {
              "type": "number",
              "const": 587
            },
            {
              "type": "number",
              "const": 2525
            }
          ]
        },
        "secure": {
          "type": "boolean"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "from": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "from_name": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\r\\n]*$"
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host",
        "port",
        "secure",
        "username",
        "from",
        "reply_to"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
