{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-execution@2026-09-23.v1"
    },
    "handoff": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "fcl-handoff@2026-09-21.v1"
        },
        "case_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "expected_case_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "expected_customer_supplement_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "expected_quote_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "expected_quote_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "expected_document_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "expected_pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "contract_version",
        "case_ref",
        "expected_case_version",
        "expected_customer_supplement_ref",
        "quote_ref",
        "expected_quote_version",
        "expected_quote_digest",
        "document_id",
        "expected_document_version",
        "expected_pdf_sha256",
        "confirmed",
        "note"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "email",
            "phone",
            "chat",
            "signed_document",
            "in_person"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "contact_name": {
          "$ref": "#/$defs/__schema0"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_refs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "method",
        "confirmed_at",
        "contact_name",
        "note",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "coordinator_id": {
      "$ref": "#/$defs/__schema0"
    },
    "expected_config_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "handoff",
    "confirmation",
    "coordinator_id",
    "expected_config_version",
    "confirmed"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
