{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-notification@2026-09-23.v2"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "minItems": 10,
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "expected_version",
    "rows",
    "confirmed"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "enum": [
            "intake",
            "quote",
            "customer_followup",
            "booking",
            "pickup",
            "export_customs",
            "shipping_documents",
            "canada_customs",
            "devanning_storage",
            "delivery"
          ]
        },
        "assignment": {
          "type": "object",
          "properties": {
            "responsible_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "collaborator_ids": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema2"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cc": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "responsible_id",
            "collaborator_ids",
            "to",
            "cc",
            "enabled"
          ],
          "additionalProperties": false
        },
        "template_version": {
          "type": "string",
          "const": "fcl-node-mail@2026-09-23.v1"
        },
        "external_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_cc": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "external_enabled": {
          "type": "boolean"
        },
        "visible_fields": {
          "maxItems": 17,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "node_id",
        "assignment",
        "template_version",
        "external_to",
        "external_cc",
        "external_enabled",
        "visible_fields"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema2": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "carrier",
        "vessel_voyage",
        "booking_so",
        "etd",
        "eta",
        "cutoff",
        "pickup_location",
        "appointment",
        "declaration_ref",
        "release_evidence",
        "warehouse",
        "handover_at",
        "delivery_address",
        "signed_at",
        "empty_return_at"
      ]
    }
  }
}
