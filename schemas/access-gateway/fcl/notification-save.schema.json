{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-notification@2026-09-21.v1"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "cc": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          }
        }
      },
      "required": [
        "enabled",
        "recipient",
        "cc"
      ],
      "additionalProperties": false
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "expected_version",
    "input",
    "confirmed"
  ],
  "additionalProperties": false
}
