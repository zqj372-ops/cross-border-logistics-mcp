{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "cursor": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "inquiry_quote",
        "awaiting_confirmation",
        "executing",
        "completed"
      ]
    },
    "mine": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "limit",
    "cursor",
    "phase",
    "mine"
  ],
  "additionalProperties": false
}
