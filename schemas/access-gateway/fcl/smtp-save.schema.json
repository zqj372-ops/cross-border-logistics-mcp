{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    },
    "connection": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "port": {
          "anyOf": [
            {
              "type": "number",
              "const": 465
            },
            {
              "type": "number",
              "const": 587
            },
            {
              "type": "number",
              "const": 2525
            }
          ]
        },
        "secure": {
          "type": "boolean"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "from": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "from_name": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\r\\n]*$"
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host",
        "port",
        "secure",
        "username",
        "from",
        "reply_to"
      ],
      "additionalProperties": false
    },
    "password": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "expected_version",
    "confirmed",
    "connection",
    "password"
  ],
  "additionalProperties": false
}
