{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-execution@2026-09-23.v1"
    },
    "case_ref": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "expected_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expected_config_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preview_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "case_ref",
    "expected_version",
    "expected_config_version",
    "preview_digest",
    "confirmed"
  ],
  "additionalProperties": false
}
