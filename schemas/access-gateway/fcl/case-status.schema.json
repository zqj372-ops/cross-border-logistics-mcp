{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_review",
        "needs_input",
        "closed",
        "cancelled"
      ]
    },
    "public_note": {
      "type": "string",
      "maxLength": 2000
    },
    "internal_note": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "case_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "expected_version",
    "status",
    "public_note",
    "internal_note",
    "case_id"
  ],
  "additionalProperties": false
}
