{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "fcl-execution@2026-09-23.v1"
    },
    "case_ref": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "expected_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "node_id": {
      "type": "string",
      "enum": [
        "export_customs",
        "canada_customs"
      ]
    },
    "to": {
      "$ref": "#/$defs/__schema0"
    },
    "cc": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "attachments": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "preview_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "contract_version",
    "case_ref",
    "expected_version",
    "node_id",
    "to",
    "cc",
    "subject",
    "body",
    "attachments",
    "preview_digest",
    "confirmed"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\r\\n\\x00-\\x1f]+$"
        },
        "content_type": {
          "type": "string",
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        },
        "content_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 5592408
        }
      },
      "required": [
        "filename",
        "content_type",
        "content_base64"
      ],
      "additionalProperties": false
    }
  }
}
