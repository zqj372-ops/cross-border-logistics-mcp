{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "expected_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "locked": {
      "type": "boolean"
    },
    "recommended": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "changes": {
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sell_price": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,9})(?:\\.\\d{1,6})?$"
          }
        },
        "required": [
          "line_id",
          "sell_price"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "estimate_id",
    "expected_version",
    "locked",
    "recommended",
    "reason",
    "changes"
  ],
  "additionalProperties": false
}
