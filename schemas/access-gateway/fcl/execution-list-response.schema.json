{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "const": "success"
        },
        "data": {
          "$ref": "#/$defs/__schema0"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs_input",
            "manual_review"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "fcl-http@2026-09-21.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "blocked",
            "unavailable"
          ]
        },
        "data": {
          "type": "null"
        },
        "reason_codes": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "data",
        "reason_codes"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "case_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "inquiry_no": {
          "type": "string",
          "maxLength": 80
        },
        "customer_name": {
          "type": "string",
          "maxLength": 200
        },
        "route": {
          "type": "string",
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "enum": [
            "executing",
            "completed"
          ]
        },
        "coordinator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pending_nodes": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "exception": {
          "type": "boolean"
        }
      },
      "required": [
        "case_ref",
        "inquiry_no",
        "customer_name",
        "route",
        "state",
        "coordinator_id",
        "pending_nodes",
        "deadline",
        "exception"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "booking",
        "pickup",
        "export_customs",
        "shipping_documents",
        "canada_customs",
        "devanning_storage",
        "delivery"
      ]
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
