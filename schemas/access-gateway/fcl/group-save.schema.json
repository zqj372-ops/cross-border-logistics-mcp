{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "group": {
      "type": "string",
      "enum": [
        "customer",
        "sales",
        "operations"
      ]
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "user_id",
    "group",
    "expected_version",
    "confirmed"
  ],
  "additionalProperties": false
}
