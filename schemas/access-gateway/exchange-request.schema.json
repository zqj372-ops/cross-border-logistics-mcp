{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.logistics-mcp.invalid/access-gateway/exchange-request.schema.json",
  "title": "Unified Access Gateway token exchange request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requested_tool_names"],
  "properties": {
    "schema_version": {
      "const": "2026-08-27.v1"
    },
    "requested_tool_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cargo.calculate",
          "container.plan_summary",
          "system.agent_context.get"
        ]
      }
    }
  }
}
