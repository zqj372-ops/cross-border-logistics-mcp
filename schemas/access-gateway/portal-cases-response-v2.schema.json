{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "portal-cases@2026-09-13.v2"
    },
    "status": {
      "type": "string",
      "const": "success"
    },
    "data": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "in_review",
            "needs_input",
            "closed",
            "cancelled"
          ]
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "maxLength": 254
            },
            "services": {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            },
            "transportMode": {
              "type": "string",
              "maxLength": 254
            },
            "origin": {
              "type": "string",
              "maxLength": 254
            },
            "destination": {
              "type": "string",
              "maxLength": 254
            },
            "product": {
              "type": "string",
              "maxLength": 254
            },
            "readyDate": {
              "type": "string",
              "maxLength": 254
            },
            "containerType": {
              "type": "string",
              "maxLength": 254
            },
            "containerCount": {
              "type": "string",
              "maxLength": 254
            },
            "containerCountUnknown": {
              "type": "boolean"
            },
            "volume": {
              "type": "string",
              "maxLength": 254
            },
            "volumeUnknown": {
              "type": "boolean"
            },
            "weight": {
              "type": "string",
              "maxLength": 254
            },
            "weightUnknown": {
              "type": "boolean"
            },
            "cargoType": {
              "type": "string",
              "maxLength": 254
            },
            "palletCount": {
              "type": "string",
              "maxLength": 254
            },
            "skuCount": {
              "type": "string",
              "maxLength": 254
            },
            "deliverySite": {
              "type": "string",
              "maxLength": 254
            },
            "unloading": {
              "type": "string",
              "maxLength": 254
            },
            "businessRegion": {
              "type": "string",
              "maxLength": 254
            },
            "notes": {
              "type": "string",
              "maxLength": 4000
            },
            "contactName": {
              "type": "string",
              "maxLength": 254
            },
            "email": {
              "type": "string",
              "maxLength": 254
            },
            "company": {
              "type": "string",
              "maxLength": 254
            },
            "phone": {
              "type": "string",
              "maxLength": 254
            },
            "consent": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "services",
            "transportMode",
            "origin",
            "destination",
            "product",
            "readyDate",
            "containerType",
            "containerCount",
            "containerCountUnknown",
            "volume",
            "volumeUnknown",
            "weight",
            "weightUnknown",
            "cargoType",
            "palletCount",
            "skuCount",
            "deliverySite",
            "unloading",
            "businessRegion",
            "notes",
            "contactName",
            "email",
            "company",
            "phone",
            "consent"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "can_manage": {
          "type": "boolean"
        },
        "can_reply": {
          "type": "boolean"
        },
        "events": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "enum": [
                  "submitted",
                  "in_review",
                  "needs_input",
                  "closed",
                  "cancelled"
                ]
              },
              "message": {
                "type": "string"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "customer",
                  "internal"
                ]
              },
              "actor_label": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            },
            "required": [
              "event_id",
              "version",
              "status",
              "message",
              "visibility",
              "actor_label",
              "created_at"
            ],
            "additionalProperties": false
          }
        },
        "review_context": {
          "type": "object",
          "properties": {
            "latest_customer_supplement_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "latest_customer_supplement_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "case_id",
        "status",
        "version",
        "input",
        "created_at",
        "updated_at",
        "can_manage",
        "can_reply",
        "events",
        "review_context"
      ],
      "additionalProperties": false
    },
    "reason_codes": {
      "minItems": 0,
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "data",
    "reason_codes"
  ],
  "additionalProperties": false,
  "$id": "https://freightclaw.local/schemas/portal-cases-response-v2.schema.json"
}
