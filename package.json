{
  "name": "cross-border-logistics-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node deploy/scripts/build.mjs",
    "build:freightcom-keychain-helper": "node apps/freightcom-credential/build-helper.mjs",
    "start:freightcom-quote": "node --import tsx/esm apps/freightcom-quote/server.mjs",
    "credential:freightcom-test": "npm run build:freightcom-keychain-helper && node apps/freightcom-credential/server.mjs",
    "init:control-fixture": "npm run build && node deploy/scripts/init-control-fixture.mjs",
    "init:tenant-access-fixture": "npm run build && node deploy/scripts/init-tenant-access-fixture.mjs",
    "start:fixture": "npm run build && MCP_DATA_MODE=fixtures MCP_PORT=8080 MCP_ADMIN_UI_ENABLED=true MCP_ADMIN_CONTROL_ENABLED=true MCP_INSTANCE_ID=instance_fixture_001 MCP_ADMIN_TENANT_ID=tenant_fixture MCP_FIXTURE_TOKEN=local-fixture-token MCP_FIXTURE_APPROVER_TOKEN=local-fixture-approver-token MCP_JWT_ISSUER=https://issuer.example.invalid/ MCP_JWT_AUDIENCE=logistics-mcp-local MCP_ALLOWED_ORIGINS=http://127.0.0.1:8080 MCP_ALLOWED_HOSTS=127.0.0.1:8080 MCP_ALLOWED_OUTBOUND_HOSTS=fixture.example.invalid node dist/src/logistics_mcp/server/start.mjs",
    "start:freightcom-test-mcp": "npm run build:freightcom-keychain-helper && npm run build && MCP_DATA_MODE=fixtures MCP_FREIGHTCOM_TEST_ENABLED=true MCP_PORT=8080 MCP_ADMIN_UI_ENABLED=true MCP_ADMIN_CONTROL_ENABLED=true MCP_INSTANCE_ID=instance_fixture_001 MCP_ADMIN_TENANT_ID=tenant_fixture MCP_FIXTURE_TOKEN=local-fixture-token MCP_FIXTURE_APPROVER_TOKEN=local-fixture-approver-token MCP_JWT_ISSUER=https://issuer.example.invalid/ MCP_JWT_AUDIENCE=logistics-mcp-local MCP_ALLOWED_ORIGINS=http://127.0.0.1:8080 MCP_ALLOWED_HOSTS=127.0.0.1:8080 MCP_ALLOWED_OUTBOUND_HOSTS=customer-external-api.ssd-test.freightcom.com node dist/src/logistics_mcp/server/start.mjs",
    "start:production": "npm run build && node dist/src/logistics_mcp/server/start.mjs",
    "start:access-gateway": "npm run build && node dist/services/access-gateway/start.mjs",
    "init:access-gateway": "npm run build && node deploy/scripts/init-access-gateway.mjs",
    "smoke:t0-deployment": "node dist/services/access-gateway/deployment-smoke.mjs",
    "load:t0-deployment": "node dist/services/access-gateway/deployment-load.mjs",
    "test": "vitest run",
    "verify:runtime": "vitest run tests/e2e/runtime-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src services tests",
    "validate:schemas": "node --import tsx/esm src/logistics_mcp/platform/validate-contracts.ts && npm run validate:access-gateway-schemas",
    "validate:access-gateway-schemas": "node --import tsx/esm services/access-gateway/validate-schemas.ts",
    "validate:agent-standards": "node --import tsx/esm src/logistics_mcp/agent-context/cli.ts validate",
    "build:agent-pack": "node --import tsx/esm src/logistics_mcp/agent-context/cli.ts build",
    "agent:context": "node --import tsx/esm src/logistics_mcp/agent-context/cli.ts context",
    "test:agent-context": "vitest run tests/agent-context --pool=forks --no-file-parallelism --maxWorkers=1",
    "test:module-runtime": "vitest run tests/module-runtime --pool=forks --no-file-parallelism --maxWorkers=1",
    "test:mcp-resources": "vitest run tests/e2e/mcp-resources.test.ts --pool=forks --no-file-parallelism --maxWorkers=1 --testTimeout=5000 --hookTimeout=5000",
    "validate:agent-adapters": "node --import tsx/esm src/logistics_mcp/agent-context/cli.ts adapters",
    "test:access-gateway": "vitest run tests/access-gateway --pool=forks --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "admin-lte": "4.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bootstrap": "5.3.8",
    "decimal.js": "10.6.0",
    "jose": "6.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.21",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
