# Copy into a secret-managed deployment environment; do not commit real values.
MCP_DATA_MODE=production
MCP_PORT=8080
MCP_JWT_ISSUER=https://issuer.example.invalid/
MCP_JWT_AUDIENCE=logistics-mcp-demo
MCP_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
MCP_INSTANCE_ID=logistics-mcp-01
MCP_ALLOWED_ORIGINS=https://client.example.invalid
MCP_ALLOWED_HOSTS=mcp.example.invalid
MCP_ALLOWED_OUTBOUND_HOSTS=issuer.example.invalid
MCP_TRUSTED_PROXY_ADDRESSES=192.0.2.10

# Optional RiskCustoms M2M adapter. Keep disabled until an approved staging
# record and a published non-test release have been verified. The token is a
# deployment secret-file reference, never a value committed to this repo.
# MCP_RISK_CUSTOMS_ENABLED=true
# MCP_RISK_CUSTOMS_BASE_URL=https://riskcustoms.example.invalid
# MCP_RISK_CUSTOMS_ALLOWED_HOSTS=riskcustoms.example.invalid
# MCP_RISK_CUSTOMS_AUTH_SECRET_FILE=/run/secrets/riskcustoms_m2m_token
# The RiskCustoms host must also be included in MCP_ALLOWED_OUTBOUND_HOSTS.
