# Copy into a secret-managed deployment environment; do not commit real values.
MCP_DATA_MODE=production
MCP_PORT=8080
MCP_JWT_ISSUER=https://issuer.example.invalid/
MCP_JWT_AUDIENCE=logistics-mcp-demo
MCP_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
MCP_INSTANCE_ID=logistics-mcp-01
MCP_ALLOWED_ORIGINS=https://client.example.invalid
MCP_ALLOWED_HOSTS=mcp.example.invalid
MCP_ALLOWED_OUTBOUND_HOSTS=issuer.example.invalid
MCP_TRUSTED_PROXY_ADDRESSES=192.0.2.10

# Quote PDF is deliberately disabled. These are placeholders only; enablement
# requires an approved staging record and runtime secret injection.
MCP_QUOTE_PDF_ENABLED=false
MCP_QUOTE_PDF_BASE_URL=https://pdf.example.invalid
MCP_QUOTE_PDF_ALLOWED_HOSTS=pdf.example.invalid
MCP_QUOTE_PDF_TENANT_ID=tenant-disabled-example
MCP_QUOTE_PDF_BEARER_TOKEN=
# MCP_QUOTE_PDF_BEARER_TOKEN must come from the deployment secret manager.

# Production endpoint, tenant mapping, authentication, and RiskCustoms
# readiness contracts remain 待适配验证 until an approved staging record exists.
