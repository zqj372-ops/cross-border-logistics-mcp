# Copy into a secret-managed deployment environment; do not commit real values.
# This is a shape-only example. It contains no token, password or customer data.
MCP_DATA_MODE=production
MCP_RUNTIME_PROFILE=t0-v1
MCP_PORT=8080

# Admin control-plane remains production-blocked in v1. The literal true below
# is only a managed-state assertion; it cannot override the production POST gate.
# A deployment must first run the explicit initializer against its fixed
# application root. Startup never creates or repairs control state implicitly.
MCP_ADMIN_CONTROL_ENABLED=true
MCP_ADMIN_UI_ENABLED=false
MCP_ADMIN_TENANT_ID=tenant_management_example

MCP_JWT_ISSUER=https://issuer.example.invalid/
MCP_JWT_AUDIENCE=logistics-mcp-demo
MCP_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
MCP_INSTANCE_ID=logistics-mcp-01
MCP_ALLOWED_ORIGINS=https://client.example.invalid
MCP_ALLOWED_HOSTS=mcp.example.invalid
MCP_ALLOWED_OUTBOUND_HOSTS=issuer.example.invalid
MCP_TRUSTED_PROXY_ADDRESSES=192.0.2.10

# Unified Access Gateway single-node candidate. This profile is operationally
# testable but remains production_eligible=false until external IdP, KMS and a
# managed database replace the empty/local providers.
ACCESS_GATEWAY_PROFILE=single-node-candidate
ACCESS_GATEWAY_INSTANCE_ID=access-gateway-example-01
ACCESS_GATEWAY_MANAGEMENT_TENANT_ID=tenant_management_example
ACCESS_GATEWAY_JWT_ISSUER=https://issuer.example.invalid/
ACCESS_GATEWAY_JWT_AUDIENCE=logistics-mcp-demo
ACCESS_GATEWAY_JWT_TTL_SECONDS=300
ACCESS_GATEWAY_PEPPER_VERSION=pepper-example-v1
ACCESS_GATEWAY_RATE_LIMIT_PER_MINUTE=30
ACCESS_GATEWAY_ALLOWED_ORIGINS=https://client.example.invalid
ACCESS_GATEWAY_ALLOWED_HOSTS=mcp.example.invalid
ACCESS_GATEWAY_TRUSTED_PROXY_ADDRESSES=192.0.2.10

# Supply all four only when the approved enterprise IdP is configured.
ACCESS_GATEWAY_ADMIN_JWKS_URL=
ACCESS_GATEWAY_ADMIN_JWKS_HOST=
ACCESS_GATEWAY_ADMIN_ISSUER=
ACCESS_GATEWAY_ADMIN_AUDIENCE=

# The control DB and marker are not configurable with an env path. They are
# derived from the explicit absolute application root as:
#   <application-root>/.runtime/mcp-instance-state/control.sqlite
#   <application-root>/.runtime/mcp-instance-state/control-identity.json
# Do not use MCP_STATE_DB_PATH as a control-plane path override.

# Production endpoint, tenant mapping, authentication, multi-instance fencing
# and Admin identity contracts remain 待适配验证 until an approved staging
# record exists.
# Do not set MCP_FIXTURE_TOKEN or fixture approver credentials in production;
# fixture identities are loopback-local only. Never put secrets in this file,
# URLs, browser storage, logs or audit events.
