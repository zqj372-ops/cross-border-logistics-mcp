# Portal: after verified migration to the existing Access Gateway PostgreSQL schema.
PORTAL_STORE_BACKEND=postgresql
# ACCESS_GATEWAY_STORE_BACKEND and ACCESS_GATEWAY_POSTGRES_* must select the same
# shared authority on every replica; password/cert values remain private file paths.
PORTAL_MCP_PROVIDER_SECRET_FILE=/run/portal-secrets/mcp-provider-secret

# Runtime: explicit new profile; legacy installations may keep t0-v1.
MCP_RUNTIME_PROFILE=business-v1
MCP_BUSINESS_RELEASE_FILE=/run/provider-release/release.json
MCP_BUSINESS_SIGNERS_FILE=/run/provider-release/trusted-signers.json
MCP_BUSINESS_RELEASE_STATE_PATH=/var/lib/logistics-mcp/provider-activation.json
MCP_BUSINESS_PROVIDER_ALLOWED_HOST=provider-version.example.invalid
MCP_BUSINESS_PROVIDER_SECRET_FILE=/run/provider-secrets/mcp-provider-secret
MCP_APPLICATION_AUTHORITY_URL=https://www.freightclaw.net/access/v2/application/token/authority
MCP_APPLICATION_AUTHORITY_ALLOWED_HOSTS=www.freightclaw.net
MCP_CALL_LOG_BACKEND=postgresql
# Runtime call-log storage uses ACCESS_GATEWAY_POSTGRES_* configuration, with
# a DB role restricted to portal_call_events and its schema after migration.

# Runtime-side database paths must match the compose.business-runtime.yml mount.
# Set the other ACCESS_GATEWAY_POSTGRES_* values from your reviewed environment.
ACCESS_GATEWAY_STORE_BACKEND=postgresql
ACCESS_GATEWAY_POSTGRES_PASSWORD_FILE=/run/provider-secrets/call-log-db-password
# For verify-full TLS also mount and configure ACCESS_GATEWAY_POSTGRES_SSL_ROOT_CERT_FILE.
