# Use instead of portal-locations.nginx inside the HTTPS server for shared Portal replicas.
# Docker DNS is re-resolved so replacement replicas are discovered without reload.
resolver 127.0.0.11 valid=10s ipv6=off;
set $portal_upstream portal:8082;
location = /console { return 308 /console/; }
location ^~ /console/ {
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header X-Real-IP $http_cf_connecting_ip;
}
# Each authenticated MCP request checks current application authority. This is
# a read-only JWT verification route, not a long-key token issuance request.
location = /access/v2/application/token/authority {
    limit_req zone=freightclaw_mcp burst=10 nodelay;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
}
location = /access/v2/application/mcp/token/authority {
    limit_req zone=freightclaw_mcp burst=10 nodelay;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
}
location = /access/v2/application/token/health {
    limit_req zone=freightclaw_mcp burst=10 nodelay;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
}
location ^~ /access/v2/application/mcp/tools/ {
    limit_req zone=freightclaw_mcp burst=10 nodelay;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Freightclaw-Runtime-Token $http_x_freightclaw_runtime_token;
    proxy_set_header Cookie "";
}
location ^~ /access/v2/ {
    limit_req zone=freightclaw_exchange burst=5 nodelay;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
}
location ^~ /api/v2/ {
    limit_req zone=freightclaw_mcp burst=10 nodelay;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
}
