# Include inside the existing HTTPS server. Keep initial setup tunnel-only.
location = /if/flow/initial-setup/ { return 404; }
location = /api/v3/flows/executor/initial-setup/ { return 404; }
location ^~ /application/o/ {
    proxy_pass http://logistics-authentik-server:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header X-Real-IP $http_cf_connecting_ip;
}
location ^~ /if/ {
    proxy_pass http://logistics-authentik-server:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
}
location ^~ /api/v3/ {
    proxy_pass http://logistics-authentik-server:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
}
location ^~ /static/ {
    proxy_pass http://logistics-authentik-server:9000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
