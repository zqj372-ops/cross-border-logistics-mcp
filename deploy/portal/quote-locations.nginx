# Preserve the source service's complete M2M path. Browser/API business calls
# arrive here only after the Portal has injected its server-side delegation.
location ^~ /api/v1/m2m/quote/ {
    limit_req zone=freightclaw_mcp burst=10 nodelay;
    client_max_body_size 64k;
    proxy_pass http://freightclaw-quote-api:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie "";
    proxy_read_timeout 60s;
    proxy_send_timeout 30s;
}
