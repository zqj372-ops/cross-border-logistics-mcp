# Shape-only example. Keep real endpoint qualification, tenant mappings and
# secret material in the staging deployment system, never in Git.
READ_PREVIEW_IMAGE=cross-border-logistics-mcp:read-preview-candidate
READ_PREVIEW_SECRET_DIR=/run/freightclaw/read-preview/secrets
QUOTE_PREVIEW_ORIGIN_MAP_FILE=/run/freightclaw/read-preview/config/quote-preview-origin-map.json

MCP_JWT_ISSUER=https://issuer.example.invalid/
MCP_JWT_AUDIENCE=logistics-mcp-read-preview-staging
MCP_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
MCP_INSTANCE_ID=logistics-mcp-read-preview-staging-01
MCP_ALLOWED_ORIGINS=https://client.example.invalid
MCP_ALLOWED_HOSTS=mcp.example.invalid
MCP_ALLOWED_OUTBOUND_HOSTS=issuer.example.invalid,quote.example.invalid,riskcustoms.example.invalid,customer-external-api.ssd-test.freightcom.com
MCP_TRUSTED_PROXY_ADDRESSES=192.0.2.10

MCP_QUOTE_PREVIEW_ENABLED=false
MCP_QUOTE_PREVIEW_BASE_URL=https://quote.example.invalid
MCP_QUOTE_PREVIEW_ALLOWED_HOSTS=quote.example.invalid

MCP_RISK_CUSTOMS_ENABLED=false
MCP_RISK_CUSTOMS_BASE_URL=https://riskcustoms.example.invalid
MCP_RISK_CUSTOMS_ALLOWED_HOSTS=riskcustoms.example.invalid
MCP_RISK_CUSTOMS_ALLOWED_TENANTS=tenant-staging

MCP_FREIGHTCOM_TEST_ENABLED=false
MCP_FREIGHTCOM_TEST_ALLOWED_TENANTS=tenant-staging
